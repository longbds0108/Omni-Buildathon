# Copy to .env and `source .env` (never commit .env). Either a Foundry keystore account or a private key.
ACCOUNT=deployer
# PRIVATE_KEY=0x...
BASE_SEPOLIA_RPC=https://sepolia.base.org
LASNA_RPC=https://lasna-rpc.rnk.dev/
# DEMO_BORROWER=0x...          # defaults to the deployer
# RECEIVER_FUNDING_WEI=10000000000000000      # 0.01 ETH for callback gas on Base Sepolia
# REACTIVE_FUNDING_WEI=1000000000000000000    # 1 lREACT for reactive gas on Lasna
# CALLBACK_GAS_LIMIT=600000
# LASNA_FLAGS=--legacy
