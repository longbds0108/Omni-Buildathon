# WalletConnect project ID for RainbowKit (QR code and mobile wallets). Free at https://cloud.reown.com.
# Leave empty to offer browser-extension wallets and Coinbase Wallet only.
VITE_WALLETCONNECT_PROJECT_ID=

# Developer only: 1 enables the in-browser simulation and local anvil manifests. Leave unset in any real build:
# without it the dashboard shows real testnet data only, or a "not deployed yet" page.
# VITE_DEV_SIMULATION=1
